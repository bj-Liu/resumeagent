# Documentation template only: ResumeAgent does not auto-load .env files.
# Set variables in your shell or load this file with your preferred environment tool.
LLM_TYPE=openai
is_azure=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PROXY_URL=

# For Qwen: set LLM_TYPE=qwen and select a vision model with --model.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
# DASHSCOPE_WORKSPACE_ID=

# For Azure OpenAI: set is_azure=true.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=

# Optional local paths (do not commit private files):
# RESUMEAGENT_CONFIG=/absolute/path/to/config.yaml
# TOKEN_LOG_FILE=/absolute/path/to/token.json
# WEBDRIVER_PATH=/absolute/path/to/browser-driver
